# Proxy target for local dev — replace with a hosted Bento URL as needed.
VITE_BENTO_URL=http://localhost:3000

# Canonical public origin, e.g. https://courtside.example.com. Used at build
# time for canonical/og:url, robots.txt Sitemap, and sitemap.xml locs. Empty =
# those SEO absolute URLs are omitted and the build still succeeds.
SITE_URL=
