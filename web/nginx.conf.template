# Production SPA config; Bento is reachable through a transparent /api proxy

# Per-IP rate limit: 30 req/s burstable to 10.
limit_req_zone $binary_remote_addr zone=api_req:10m rate=30r/s;

# Per-IP connection limit: 10 concurrent connections.
limit_conn_zone $binary_remote_addr zone=api_conn:10m;

# Authenticated operational routes: at most one active batch per client.
limit_conn_zone $binary_remote_addr zone=op_conn:10m;

# Compress text assets. The SPA is served same-origin through this proxy, so no
# CORS headers are needed: the browser only ever calls /api on its own origin.

gzip on;
gzip_comp_level 5;
gzip_min_length 1024;

# Vary advertises the encoding so proxies/CDNs cache gzip and identity separately.
gzip_vary on;
gzip_types text/plain text/css application/json application/javascript text/javascript application/xml image/svg+xml;

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Global timeouts for all proxy requests. The upstream read window is sized
    # for bulk predictions (up to 1,000 rows per request); the internal batch
    # location scopes its own explicit 120s read timeout.
    proxy_connect_timeout 10s;
    proxy_read_timeout 120s;
    proxy_send_timeout 10s;

    # Prediction payloads are tiny feature rows.
    client_max_body_size 10k;

    # Generic gateway errors: intercept upstream 502/504 and return JSON.
    proxy_intercept_errors on;
    error_page 502 504 /502.json;
    location = /502.json {
        internal;
        default_type application/json;
        return 502 '{"ok":false,"error":"upstream unavailable"}';
    }

    # --- Authenticated operational routes (header X-API-Key) ---
    # Longer prefixes than the public /api/ proxy below, so nginx routes these
    # first. Paths are the direct Bento route names with only the /api prefix
    # stripped (no internal route renames).

    location /api/model_info {
        limit_req zone=api_req burst=5 nodelay;
        limit_conn api_conn 5;

        # Only GET allowed.
        limit_except GET {
            deny all;
        }

        if ($http_x_api_key != "${BENTO_API_KEY}") {
            return 401 '{"ok":false,"error":"unauthorized"}';
        }

        proxy_pass ${BENTO_API_URL}/model_info;
        proxy_http_version 1.1;
    }

    location /api/predict_from_ids_bulk {
        limit_req zone=api_req burst=1 nodelay;
        # One active batch per client.
        limit_conn op_conn 1;

        # Only POST allowed.
        limit_except POST {
            deny all;
        }

        if ($http_x_api_key != "${BENTO_API_KEY}") {
            return 401 '{"ok":false,"error":"unauthorized"}';
        }

        # The body must be JSON.
        if ($content_type !~ ^application/json) {
            return 415 '{"ok":false,"error":"content-type must be application/json"}';
        }

        # Operational limits override the public 10k body cap: 10 MiB body,
        # explicit 120s upstream window. Bento itself rejects >1,000 rows.
        client_max_body_size 10m;
        proxy_read_timeout 120s;

        proxy_pass ${BENTO_API_URL}/predict_from_ids_bulk;
        proxy_http_version 1.1;
    }

    # --- Explicitly reject the model-only /predict endpoint ---
    # Exact match only, so /api/predict_from_ids* still fall through to the
    # public /api/ proxy below instead of being shadowed by a prefix match.
    location = /api/predict {
        return 403 '{"ok":false,"error":"model-only /predict is not exposed; use /api/predict_from_ids"}';
    }

    # --- Public transparent Bento API proxy (mirrors the Vite proxy) ---
    # Strips the /api/ prefix exactly as Vite does:
    #   /api/              -> Bento /                       (Swagger UI)
    #   /api/docs.json     -> Bento /docs.json              (OpenAPI schema)
    #   /api/static_content/* -> Bento /static_content/*    (Swagger assets)
    #   /api/health, /api/predict_from_ids, ... -> root Bento routes
    location /api/ {
        limit_req zone=api_req burst=10 nodelay;
        limit_conn api_conn 10;

        proxy_pass ${BENTO_API_URL}/;
        proxy_http_version 1.1;
    }

    # --- Asset caching ---
    # Vite emits content-hashed asset filenames, so they are safe to cache
    # for a year; index.html itself is never cached so deploys roll out.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # The generated directory/search payloads are content-hashed, so each gets
    # the same immutable year-long cache as Vite bundles. The manifest name is
    # deliberately not a hex hash, so this regex never matches it with a stale
    # forever cache. Quoted: an unquoted {64} quantifier would be parsed as a
    # config block.
    location ~ "^/player-(?:directory|search)\.[0-9a-f]{64}\.json$" {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Tiny mutable pointer to the current hashed payload: the browser
    # revalidates it on every load, so a new deploy is discovered as soon as
    # its index.html is.
    location = /player-index.manifest.json {
        add_header Cache-Control "no-cache";
    }

    location = /index.html {
        add_header Cache-Control "no-store";
    }

    # --- SPA root ---
    location / {
        try_files $uri $uri/ /index.html;
    }
}
