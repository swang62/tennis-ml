# Production SPA config; Bento is reachable only through allowlisted /api routes.
# Rendered at container start by the official nginx image's envsubst template
# mechanism (/etc/nginx/templates/*.template). Substitution is allowlisted to
# DRIFT_API_KEY and BENTO_API_URL via NGINX_ENVSUBST_FILTER in the Dockerfile,
# so all native nginx $variables below are preserved verbatim.
# BENTO_API_URL defaults to http://bento:3000 (see compose.yaml).

# Per-IP rate limit: 30 req/s burstable to 10.
limit_req_zone $binary_remote_addr zone=api_req:10m rate=30r/s;
# Per-IP connection limit: 10 concurrent connections.
limit_conn_zone $binary_remote_addr zone=api_conn:10m;
# Authenticated operational routes: at most one active batch per client.
limit_conn_zone $binary_remote_addr zone=op_conn:10m;

# Compress text assets. The SPA is served same-origin through this proxy, so no
# CORS headers are needed: the browser only ever calls /api on its own origin.

gzip on;
gzip_comp_level 5;
gzip_min_length 1024;
gzip_types text/plain text/css application/json application/javascript application/xml image/svg+xml;

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Global timeouts for all proxy requests. The upstream read window is sized
    # for bulk predictions (up to 1,000 rows per request); the internal batch
    # location scopes its own explicit 120s read timeout.
    proxy_connect_timeout 5s;
    proxy_read_timeout 120s;
    proxy_send_timeout 10s;

    # Prediction payloads are tiny feature rows.
    client_max_body_size 10k;

    # Generic gateway errors: intercept upstream 502/504 and return JSON.
    proxy_intercept_errors on;
    error_page 502 504 /502.json;
    location = /502.json {
        internal;
        default_type application/json;
        return 502 '{"ok":false,"error":"upstream unavailable"}';
    }

    # --- Allowlisted SPA data routes (GET) ---

    location /api/players {
        limit_req zone=api_req burst=10 nodelay;
        limit_conn api_conn 10;
        proxy_pass ${BENTO_API_URL}/players;
        proxy_http_version 1.1;
    }

    location /api/player_profile {
        limit_req zone=api_req burst=10 nodelay;
        limit_conn api_conn 10;
        proxy_pass ${BENTO_API_URL}/player_profile;
        proxy_http_version 1.1;
    }

    location /api/rank_history {
        limit_req zone=api_req burst=10 nodelay;
        limit_conn api_conn 10;
        proxy_pass ${BENTO_API_URL}/rank_history;
        proxy_http_version 1.1;
    }

    location /api/match_history {
        limit_req zone=api_req burst=10 nodelay;
        limit_conn api_conn 10;
        proxy_pass ${BENTO_API_URL}/match_history;
        proxy_http_version 1.1;
    }

    location /api/head_to_head {
        limit_req zone=api_req burst=10 nodelay;
        limit_conn api_conn 10;
        proxy_pass ${BENTO_API_URL}/head_to_head;
        proxy_http_version 1.1;
    }

    location /api/similar_players {
        limit_req zone=api_req burst=10 nodelay;
        limit_conn api_conn 10;
        proxy_pass ${BENTO_API_URL}/similar_players;
        proxy_http_version 1.1;
    }

    # --- Allowlisted prediction route (POST only) ---

    location /api/predict_from_ids {
        # Stricter prediction rate limit.
        limit_req zone=api_req burst=5 nodelay;
        limit_conn api_conn 5;

        # Only POST allowed.
        limit_except POST {
            deny all;
        }

        # The body must be JSON.
        if ($content_type !~ ^application/json) {
            return 415 '{"ok":false,"error":"content-type must be application/json"}';
        }

        proxy_pass ${BENTO_API_URL}/predict_from_ids;
        proxy_http_version 1.1;
    }

    # --- Authenticated operational routes (header X-Drift-API-Key) ---

    location /api/internal/model-info {
        limit_req zone=api_req burst=5 nodelay;
        limit_conn api_conn 5;

        # Only GET allowed.
        limit_except GET {
            deny all;
        }

        if ($http_x_drift_api_key != "${DRIFT_API_KEY}") {
            return 401 '{"ok":false,"error":"unauthorized"}';
        }

        proxy_pass ${BENTO_API_URL}/model_info;
        proxy_http_version 1.1;
    }

    location /api/internal/predict-batch {
        limit_req zone=api_req burst=1 nodelay;
        # One active batch per client.
        limit_conn op_conn 1;

        # Only POST allowed.
        limit_except POST {
            deny all;
        }

        if ($http_x_drift_api_key != "${DRIFT_API_KEY}") {
            return 401 '{"ok":false,"error":"unauthorized"}';
        }

        # The body must be JSON.
        if ($content_type !~ ^application/json) {
            return 415 '{"ok":false,"error":"content-type must be application/json"}';
        }

        # Operational limits override the public 10k body cap: 10 MiB body,
        # explicit 120s upstream window. Bento itself rejects >1,000 rows.
        client_max_body_size 10m;
        proxy_read_timeout 120s;

        proxy_pass ${BENTO_API_URL}/predict_from_ids_bulk;
        proxy_http_version 1.1;
    }

    # --- Explicitly reject the model-only /predict endpoint ---
    location /api/predict {
        return 403 '{"ok":false,"error":"model-only /predict is not exposed; use /api/predict_from_ids"}';
    }

    # --- Catch-all for unknown API paths ---
    location /api/ {
        return 404 '{"ok":false,"error":"unknown api endpoint"}';
    }

    # --- Asset caching ---
    # Vite emits content-hashed asset filenames, so they are safe to cache
    # for a year; index.html itself is never cached so deploys roll out.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location = /index.html {
        add_header Cache-Control "no-store";
    }

    # --- SPA root ---
    location / {
        try_files $uri $uri/ /index.html;
    }
}
