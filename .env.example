# Copy to .env and fill in. Placeholders only — the real .env is git-ignored
# and never committed. Consumed by src/constants.py (load_dotenv), the
# Compose stack (compose.yaml interpolation), and scripts/dev.sh.

# ============ Shared (host dev + Compose) ============
# Required. Authenticates the /api/model_info and /api/predict_from_ids_bulk nginx routes (drift checks,
# notebook 05_evaluate). scripts/dev.sh generates one automatically when empty;
# Compose fails fast without it.
BENTO_API_KEY=

# ============ Host development (Python, dbt, notebooks, worker) ============
# Required. Single source of truth for PostgreSQL connections (src/db/client);
# dbt derives POSTGRES_* from it via src/db/conninfo. Homebrew trust example:
DATABASE_URL=postgresql://user@127.0.0.1:5432/tennis
# Compose stack alternative:
# postgresql://postgres:<POSTGRES_PASSWORD>@127.0.0.1:6543/tennis

# Optional. MLflow tracking server; default is the local ./mlruns store.
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
# Optional. Set true when tracking runs behind a self-signed HTTPS MLflow.
MLFLOW_TRACKING_INSECURE_TLS=true

# Optional. CloakBrowser Pro license key (rankings scraper); without it the free binary runs.
CLOAKBROWSER_LICENSE_KEY=

# Optional. Prefect server for the host worker (src/flows/worker); default is
# the k3d node port on localhost:4200.
PREFECT_API_URL=http://localhost:4200/api
PREFECT_API_TLS_INSECURE_SKIP_VERIFY=True

# Optional (default http://127.0.0.1:8187). Host nginx in front of the
# incumbent Bento serving /api/model_info and /api/predict_from_ids_bulk (drift check, 05_evaluate).
PRODUCTION_BENTO_URL=http://127.0.0.1:8187

# Optional (default INFO). BentoML serve log verbosity (src/serving/service.py).
LOG_LEVEL=INFO

# ============ Docker Hub publish (just deploy) ============
# Optional (default swang62). Registry owner prefixing the pushed image.
DOCKER_REPO=swang62
# Optional. Hub username for the token login (default: DOCKER_REPO owner).
DOCKER_USERNAME=your-dockerhub-username
# Optional. Access token passed via stdin to `docker login`; omit to rely on
# an already-authenticated Docker CLI.
DOCKER_TOKEN=

# ============ Docker Compose production stack (docker compose up) ============
# Required. Password for the postgres container; bento's DATABASE_URL derives
# from it. BENTO_API_KEY above is also required — Compose demands both.
POSTGRES_PASSWORD=
# Optional (default http://bento:3000). nginx proxy target inside the stack.
BENTO_API_URL=http://bento:3000
